{
  "name": "poidem-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Движок рендера рилсов «Пойдём»: моушн в стиле бренда, лайфстайл-клипы, демо приложения",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "render": "node scripts/render.ts",
    "validate": "node scripts/validate.ts",
    "smoke": "node scripts/smoke.ts",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "voice": "node scripts/voice.ts",
    "sfx": "node scripts/sfx.ts"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dela-gothic-one": "5.3.0",
    "@fontsource/onest": "5.3.1",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "ajv": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
